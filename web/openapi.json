    "operationId": "assignment_experiments__experiment_id__assignment_get",
    "parameters": [
     {
      "in": "path",
      "name": "experiment_id",
      "required": true,
      "schema": {
       "title": "Experiment Id",
       "type": "string"
      }
     },
