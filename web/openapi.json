 "paths": {
  "/activity": {
   "get": {
    "operationId": "activity_activity_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/ActivityOut"
         },
         "title": "Response Activity Activity Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Activity"
   }
  },
  "/ask": {
   "post": {
    "operationId": "ask_endpoint_ask_post",
