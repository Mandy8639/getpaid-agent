# Copy to .env. Never commit .env.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Every request sets provider data_collection=deny.
OPENROUTER_MODELS=
# Hard cap for the whole build (cumulative ledger in .spend/ledger.json). No daily limit.
TOTAL_SPEND_CAP_USD=5.00
SPEND_RESERVE_USD=0.05
DATABASE_URL=postgresql+psycopg://getpaid:getpaid@localhost:5434/getpaid


# Data source: fixture (sample files) or mcp (live sandbox via the MCP server)
SOURCE=fixture
DRAFTER=template
